# ==============================================================================
# WikiSkill Environment Configuration Template (.env.example)
# ==============================================================================

# Google Cloud Platform & Vertex AI Settings
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_GENAI_USE_ENTERPRISE=True
GEMINI_API_KEY="your-gemini-api-key"

# Inference Agent Model Configuration (Default: Gemini 3.8 Flash)
INFERENCE_MODEL="gemini-3.8-flash"
INFERENCE_MODEL_LOCATION="eu"
TEMPERATURE=0.0

# Wiki Maintainer Model Configuration
# Note: Keep the exact variable name WIKI_MANTANCER_MODEL as used in codebase
WIKI_MANTANCER_MODEL="gemini-3.8-flash"
WIKI_MANTANCER_MODEL_LOCATION="eu"

# Skill Proposer Model Configuration
SKILL_PROPOSER_MODEL="gemini-3.8-flash"
SKILL_PROPOSER_MODEL_LOCATION="eu"

# Model Thinking & Recursion Controls
THINKING_LEVEL="high"
INCLUDE_THOUGHTS=True
LANGGRAPH_RECURSION_LIMIT=999
